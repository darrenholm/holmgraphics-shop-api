# .env — copy this to .env and fill in your values
# NEVER commit .env to git

# Railway Postgres connection string.
# Local dev: use the PUBLIC proxy URL from Railway dashboard
#   (Postgres service → Connect → DATABASE_PUBLIC_URL, ends in .rlwy.net).
# In production on Railway, this is auto-injected when the Postgres
# plugin is attached — do NOT set it manually in the service.
DATABASE_URL=postgresql://postgres:PASSWORD@HOST.proxy.rlwy.net:PORT/railway

# JWT secret — change this to something long and random
JWT_SECRET=holmgraphics-change-this-to-something-random-2026

# JWT expiry
JWT_EXPIRES_IN=8h

# Server port
PORT=3000

# Allowed frontend origins (comma-separated). Order does not matter;
# the CORS check is a flat membership test (server.js).
# Include every host that should be able to call the API:
#   • localhost for dev
#   • the apex (customer + marketing)
#   • the www apex (will 301 to apex but origin is still sent)
#   • the staff subdomain
#   • the .pages.dev URL Cloudflare assigns the project (preview deploys)
CORS_ORIGINS=http://localhost:5173,https://holmgraphics.ca,https://www.holmgraphics.ca,https://shop.holmgraphics.ca,https://holmgraphics-shop.pages.dev

# Customer-facing base URL — used in proof / order emails to build links
# back into the shop. Defaults to https://shop.holmgraphics.ca for
# legacy compatibility; set this to the apex now that customer routes
# live there.
PUBLIC_SHOP_URL=https://holmgraphics.ca

# Staff app base URL — used by routes/quickbooks.js to redirect users
# back to the QB admin page after the OAuth callback completes.
STAFF_APP_URL=https://shop.holmgraphics.ca

# ─── Tax (place-of-supply) ───────────────────────────────────────────────────
# Two-letter province code that determines tax for in-person PICKUP
# orders. Canadian place-of-supply rule: in-person sales are taxed at
# the seller's location, not the customer's. The shop is in Walkerton,
# ON, so 'ON' (HST 13%) is the correct default. Change here AND on
# Railway if the shop relocates.
#
# Ship orders ignore this — they use the customer's ship_to.province.
SELLER_PROVINCE=ON

# ─── Resend (transactional email) ────────────────────────────────────────────
# lib/customer-mailer.js sends activation, password reset, order
# confirmation, proof, shipping, and refund emails through Resend's
# REST API. Without RESEND_API_KEY the mailer falls back to console-only
# logging — fine for local dev, NOT fine for production.
#
# Setup (one-time):
#   1. Resend dashboard → Domains. If holmgraphics.ca isn't already
#      verified for the other project on this account, add it (Resend
#      walks you through 2 DNS records: SPF TXT + DKIM TXT).
#   2. Resend → API Keys → create a key with "Sending access" scope.
#      Copy the key here.
#
# SHOP_FROM_EMAIL must be a verified sender on the verified domain
# (e.g. orders@holmgraphics.ca). The "Holm Graphics <...>" prefix is
# the display name customers see in their inbox.
#
# SHOP_REPLY_TO is optional — set this if you want replies routed to
# a different inbox than the From: address.
RESEND_API_KEY=
SHOP_FROM_EMAIL=Holm Graphics <orders@holmgraphics.ca>
SHOP_REPLY_TO=

# Where new quote-request submissions from the homepage form get sent.
# Defaults to the address inside SHOP_FROM_EMAIL if unset.
SHOP_QUOTES_TO=orders@holmgraphics.ca

# ─── SMS notifications (SkySwitch CloudMessage) ──────────────────────────────
# lib/sms.js texts staff (lib/employee-notifier.js) + clients
# (lib/client-notifier.js). Provider is SkySwitch's Business SMS product,
# CloudMessage (api.cloudmessage.io). Without complete creds the module runs in
# stub mode (logs [sms:<kind>], sends nothing) — fine for dev.
#
# Setup (one-time):
#   1. Portal (app.skyswitch.com) → Apps → CloudMessage → open your account →
#      "API & Relay" tab → Generate API Access Token → SKYSWITCH_API_TOKEN,
#      and copy the "Account UID" on that same tab → SKYSWITCH_ACCOUNT_ID.
#   2. Attach your SMS-enabled DID to that CloudMessage account (Account Type
#      "User + Number"). That number is SKYSWITCH_SMS_FROM (E.164).
#   3. The send endpoint defaults to https://api.cloudmessage.io/api/send
#      (override with SKYSWITCH_SEND_URL only if the API docs differ).
#
# CloudMessage sends JSON { to, from, message }. Auth (per the "UserToken"
# scheme) is: Authorization: Bearer <accountUid>:<apiKey> — the code joins
# SKYSWITCH_ACCOUNT_ID and SKYSWITCH_API_TOKEN with a colon. Both are REQUIRED.
# The header/prefix are overridable (SKYSWITCH_AUTH_HEADER / _AUTH_PREFIX) only
# if the scheme ever changes.
SMS_PROVIDER=cloudmessage
SKYSWITCH_API_TOKEN=
SKYSWITCH_ACCOUNT_ID=
SKYSWITCH_SMS_FROM=+15195073001
# Optional overrides (defaults are correct for CloudMessage):
SKYSWITCH_SEND_URL=https://api.cloudmessage.io/api/send
SKYSWITCH_AUTH_HEADER=Authorization
SKYSWITCH_AUTH_PREFIX=Bearer
# ── Telco API alternative (NOT used — CloudMessage chosen) ────────────────────
# Only if you switch to SMS_PROVIDER=skyswitch (the Telco API). Creds via your
# Account Manager; endpoint differs from CloudMessage.
SKYSWITCH_API_BASE=https://api.skyswitch.com
SKYSWITCH_TOKEN_URL=
SKYSWITCH_CLIENT_ID=
SKYSWITCH_CLIENT_SECRET=
SKYSWITCH_API_USER=
SKYSWITCH_API_PASSWORD=

# Staff app base URL used to build the tap-through job link in the SMS
# (…/jobs/<id>). Defaults to https://shop.holmgraphics.ca if unset.
SHOP_STAFF_BASE=https://shop.holmgraphics.ca

# --- Telephony: inbound call screen pop (Phase 1) ----------------------------
# Shared secret the Grandstream desk phones put in the Action URL path. The
# API compares it with crypto.timingSafeEqual; an unset value leaves the
# ingest endpoints closed (every request 401s).
#
# KEEP IT SHORT. The GXP16xx/21xx Action URL field silently stops firing above
# roughly 60-70 characters -- the phone accepts the URL, stores it, shows it
# back to you, and never sends a request. The full URL is
#
#     https://api.holmgraphics.ca/t/<token>?r=$remote&e=$active_user
#
# which is 55 characters plus the token. 12 characters (71 bits of entropy)
# lands the whole thing at 67 and is the recommended length. Generate one:
#
#     node -e "const c=require('crypto'),A='abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789';let s='',b=c.randomBytes(64),i=0;while(s.length<12){const v=b[i++];if(v<248)s+=A[v%62]}console.log(s)"
#
# Set the SAME value in Railway. Never commit the real one.
# GET /api/telephony/config (admin) prints the exact URLs to paste into each
# phone, with their character counts, so an over-budget URL is caught before
# it costs you an afternoon.
TELEPHONY_INGEST_TOKEN=

# Public origin the phones dial. Only used to build the strings shown by
# /api/telephony/config -- the ingest endpoints themselves don't care.
# Must stay short; the Railway *.up.railway.app hostname is 46 characters and
# blows the URL budget on its own.
TELEPHONY_PUBLIC_BASE=https://api.holmgraphics.ca

# ─── ShipTime ────────────────────────────────────────────────────────────────
# ShipTime production uses OAuth2 client_credentials; sandbox uses HTTP Basic.
# Generate credentials in the ShipTime app: Integrations → My Integrations →
# ShipTime API Integration → Create Client ID. Note the secret is only
# revealed at creation time.
#
# To swap between environments:
#   Production: SHIPTIME_BASE_URL=https://restapi.shiptime.com/rest
#               SHIPTIME_AUTH_MODE=oauth   (or unset; oauth is default)
#   Sandbox:    SHIPTIME_BASE_URL=https://sandboxapi.shiptime.com/rest
#               SHIPTIME_AUTH_MODE=basic
SHIPTIME_BASE_URL=https://restapi.shiptime.com/rest
SHIPTIME_CLIENT_ID=stcid_...
SHIPTIME_API_SECRET=
SHIPTIME_AUTH_MODE=oauth
# Override only if ShipTime moves the OAuth endpoint. Defaults to
# {host}/oauth2/token derived from SHIPTIME_BASE_URL.
# SHIPTIME_OAUTH_URL=

# ─── QuickBooks Online (Intuit) OAuth2 credentials ───────────────────────────
# From Intuit Developer dashboard → your app → Keys & OAuth.
# NODE_ENV=production switches the API target from sandbox to live QB.
# Leave these blank if QB integration isn't in use — the /quickbooks/*
# routes will just return "QuickBooks not connected" errors.
QB_CLIENT_ID=
QB_CLIENT_SECRET=
QB_REDIRECT_URI=https://holmgraphics-shop-api-production.up.railway.app/api/quickbooks/callback

# ─── WHC photo storage (FTPS) ────────────────────────────────────────────────
# Job photos live on WHC's cPanel hosting because Railway's filesystem is
# ephemeral (wiped on redeploy). Uploaded files stream through the API to
# public_html/shop-uploads/jobs/<project_id>/ and are served publicly from
# WHC_PUBLIC_BASE (which should point at the same folder via the website).
#
# From cPanel → FTP Accounts. Use a dedicated account scoped to the
# shop-uploads folder, NOT your main cPanel login.
WHC_FTP_HOST=ftp.holmgraphics.ca
WHC_FTP_PORT=21
WHC_FTP_USER=shop@shop.holmgraphics.ca
WHC_FTP_PASSWORD=
# Explicit FTPS (AUTH TLS on port 21). Set to "false" only if the server
# truly doesn't support TLS — plain FTP sends credentials in the clear.
WHC_FTP_SECURE=true
# Remote path, relative to the FTP user's home dir.
WHC_REMOTE_BASE=public_html/shop-uploads/jobs
# Public URL that maps to the same folder on the live site.
WHC_PUBLIC_BASE=https://holmgraphics.ca/shop-uploads/jobs

# ─── SanMar Canada (PromoStandards + Bulk Data) ──────────────────────────────
# Account #26562. PromoStandards services + SanMar-specific Bulk Data.
# UAT/sandbox uses your SanMar login; prod needs ticket to activate.
# Media Content service has its own password — set from SanMar email.
# Bulk Data sandbox is a shared id/pwd; real creds arrive separately.
SANMAR_ENV=uat
SANMAR_USERNAME=
SANMAR_PASSWORD=
SANMAR_MEDIA_PASSWORD=
SANMAR_BULK_DATA_ID=
SANMAR_BULK_DATA_PASSWORD=

# ─── Canada Sportswear (PromoStandards) ──────────────────────────────────────
# Credentials pending. Once the onboarding packet arrives, fill these and
# the endpoint URLs in suppliers/canada_sportswear/config.js.
CANADA_SPORTSWEAR_ENV=uat
CANADA_SPORTSWEAR_USERNAME=
CANADA_SPORTSWEAR_PASSWORD=

# ─── S&S Activewear (PromoStandards) ─────────────────────────────────────────
# Credentials pending.
SS_ACTIVEWEAR_ENV=uat
SS_ACTIVEWEAR_USERNAME=
SS_ACTIVEWEAR_PASSWORD=

# ─── AlphaBroder (PromoStandards) ────────────────────────────────────────────
# Credentials pending.
ALPHA_BRODER_ENV=uat
ALPHA_BRODER_USERNAME=
ALPHA_BRODER_PASSWORD=

# ─── Accounts payable (supplier invoice + statement pipeline) ────────────────
# Claude reads supplier PDFs into structured bills. Required for extraction;
# without it, uploads are stored but every row stays in extract_status=failed.
ANTHROPIC_API_KEY=
# Override the extraction model. Defaults to claude-opus-5.
AP_EXTRACT_MODEL=
# Shared secret for POST /api/ap/inbound, the machine intake path used by a
# mail rule or folder watcher. Unset = that endpoint refuses every request.
AP_INBOUND_SECRET=
# Chart-of-accounts NAME (not id) used for invoice lines the reviewer left
# uncoded, e.g. "Purchases". Posting an uncoded line fails without this.
QBO_AP_DEFAULT_ACCOUNT=
# QBO TaxCode id applied to taxable bill lines. Defaults to 7 (Ontario HST),
# the same code the invoice and salesreceipt paths use.
QBO_AP_TAX_CODE=
