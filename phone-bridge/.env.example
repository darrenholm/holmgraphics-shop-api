# phone-bridge/.env.example
# Copy to .env in the install dir (C:\holmgraphics\phone-bridge\) and fill in.
# Never commit the real .env.

# Port the handsets dial. Keep the resulting phone URL short — the GXP
# firmware silently ignores Action URLs much past ~50-60 characters:
#   http://10.10.1.24:8085/t?r=$remote&e=$active_user     (49 chars)
PORT=8085

# Where to forward. Must be the https origin; that's the whole point of the
# relay — the phones can't speak it, this can.
API_BASE=https://api.holmgraphics.ca

# Same value as TELEPHONY_INGEST_TOKEN in Railway. Lives here so it does NOT
# have to sit in six handset configs.
TELEPHONY_INGEST_TOKEN=

# Optional comma-separated allowlist of handset IPs. Empty = any private
# address. There is no shared secret on the phone side (adding one would put
# URL length back in play), so the network is the boundary — tighten this to
# the actual phones once the fleet is configured.
# ALLOWED_IPS=10.10.1.183,10.10.1.172
ALLOWED_IPS=
